{
  "name": "maxpylang-web-engine",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Browser runtime that plays maxpylang-generated .maxpat patches via Web Audio.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "gen:manifest": "node scripts/gen-manifest.mjs",
    "gen:coverage": "node scripts/gen-coverage.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vitest/browser": "^2.1.9",
    "playwright": "^1.62.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}

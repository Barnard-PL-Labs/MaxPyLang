{
  "name": "maxpylang-web-engine",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Browser runtime that plays maxpylang-generated .maxpat patches via Web Audio.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "gen:manifest": "node scripts/gen-manifest.mjs",
    "gen:objdocs": "node scripts/gen-objdocs.mjs",
    "gen:coverage": "node scripts/gen-coverage.mjs",
    "gen:io-fixtures": "../.venv/bin/python scripts/gen-io-fixtures.py",
    "test:parity": "MAXPY_PARITY=1 vitest run test/roundtrip.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vitest/browser": "^2.1.9",
    "playwright": "^1.62.1",
    "pyodide": "^314.0.3",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "codemirror": "^6.0.2"
  }
}

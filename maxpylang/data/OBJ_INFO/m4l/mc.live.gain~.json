        "args": [
          {
            "name": "db-input",
            "optional": "0",
            "type": "float"
          }
        ]
      },
      {
        "name": "assign",
        "digest": "Display and output a value",
        "description": "The word assign, followed by a floating point value, causes that value to be displayed and sent out the mc.live.gain~ object's outlet. The value, however, will not be stored. If the Parameter Visibility attribute is set to Stored Only, the assign message will not add the new value to the Live application\u2019s undo chain.",
        "args": [
          {
            "name": "assign-input",
            "optional": "0",
            "type": "float"
          }
        ]
      },
      {
        "name": "init",
        "digest": "Restore and output the initial value",
        "description": "Restore and output the initial value."
      },
      {
        "name": "(mouse)",
        "digest": "Click and drag to change the amplification.",
        "description": "Click and drag the slider to change the amplification. Hold down the Shift key for more precise mouse control."
      },
      {
        "name": "outputvalue",
        "digest": "Send the current value out the outlet",
        "description": "Sends the current value out the outlet."
      },
      {
        "name": "rawfloat",
        "digest": "Store a raw normalized value, convert to real, display, and output",
        "description": "A raw normalized value (between 0. and 1.) received in the inlet is converted to a real value, stored, displayed by mc.live.gain~ object, and the current value is sent out the outlet.",
        "args": [
          {
            "name": "input",
            "optional": "0",
            "type": "float"
          }
        ]
      },
      {
        "name": "set",
        "digest": "Set the current value without causing output",
        "description": "Sets the current value without causing output.",
        "args": [
          {
            "name": "set-slider-value",
            "optional": "0",
            "type": "float"
          }
        ]
      },

  "doc": {
    "digest": "Decibel volume slider and monitor",
    "description": "mc.live.gain~ is a slider that scales input audio signals and provides a visual indication of the current sound level on a deciBel scale.",
    "inlets": [
      {
        "id": "0",
        "type": "multi-channel signal",
        "digest": "Audio Signal to be Scaled (ch 1), (Int/Float) Parameter Value (-70.00-6.00)"

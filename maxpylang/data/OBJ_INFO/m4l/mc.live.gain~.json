        "type": "multi-channel signal",
        "digest": "Scaled Signal (ch 1)"
      },
      {
        "id": "1",
        "type": "int/float",
        "digest": "Scaled Signal (ch 2)"
      },
      {
        "id": "2",
        "type": "int/float",
        "digest": "Parameter Value (-70.00-6.00)"
      },
      {
        "id": "3",
        "type": "float/list",
        "digest": "Parameter Raw Value (0.-1.)"
      }
    ],

{
  "name": "maxpylang-docs-site",
  "private": true,
  "type": "module",
  "description": "The interactive object reference at the root of the MaxPyLang docs site. Reuses the engine in ../web without changing it.",
  "scripts": {
    "dev": "node ../web/node_modules/vite/bin/vite.js",
    "build": "node ../web/node_modules/typescript/bin/tsc -p . && node ../web/node_modules/vite/bin/vite.js build",
    "test": "node ../web/node_modules/vitest/vitest.mjs run",
    "test:browser": "node ../web/node_modules/vitest/vitest.mjs run --config vitest.browser.config.mjs"
  }
}
